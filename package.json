{
  "name": "claude-code-binary-tree",
  "version": "1.0.0",
  "description": "Self-driving agent framework with OODA loop, governance, and enhancement capabilities",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "ccb": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "dev:watch": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "cli": "tsx src/cli.ts",
    "demo": "tsx src/demo.ts",
    "demo:ooda": "tsx src/agent_layer/demo.ts",
    "demo:enhanced": "tsx src/agent_layer/enhanced_demo.ts",
    "demo:governance": "tsx src/agent_layer/governance_demo.ts",
    "demo:modular": "tsx src/examples/modular_app.ts",
    "test": "vitest",
    "test:watch": "vitest watch",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --fix .",
    "format": "biome format --write .",
    "check": "biome check ."
  },
  "dependencies": {
    "@hono/node-server": "^2.0.5",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "better-sqlite3": "^12.11.1",
    "hono": "^4.12.26",
    "yaml": "^2.8.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^3.0.5",
    "fast-check": "^4.8.0",
    "tsx": "^4.19.3",
    "typescript": "^6.0.3",
    "vitest": "^3.0.5"
  }
}
