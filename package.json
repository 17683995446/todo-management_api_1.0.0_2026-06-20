{
  "name": "claude-code-binary-tree",
  "version": "1.0.0",
  "description": "Claude Code restructured as full binary tree architecture",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx src/main.ts",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --fix .",
    "format": "biome format --write .",
    "check": "biome check ."
  },
  "dependencies": {
    "yaml": "^2.8.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^3.0.5",
    "tsx": "^4.19.3",
    "typescript": "^6.0.3",
    "vitest": "^3.0.5"
  }
}
