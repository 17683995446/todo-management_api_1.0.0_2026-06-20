# 运行环境（development / test / prod / docker）
# 对应 config/<NODE_ENV>.yaml 配置文件
NODE_ENV=development

# SQLite 数据库文件路径
# 默认：data/todos.db
DB_PATH=data/todos.db

# 日志级别覆盖（trace / debug / info / warn / error）
# 设置后会覆盖 config/<NODE_ENV>.yaml 中的 logging.level
# 便于临时排查问题：LOG_LEVEL=debug npm run dev
# LOG_LEVEL=info

